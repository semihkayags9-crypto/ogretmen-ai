{
  "name": "ogretmen-ai",
  "version": "0.3.0",
  "description": "8 yas grubu icin sesli/yazili blok-kodlama ogretmeni AI - temel iskelet",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux --x64",
    "release:win": "electron-builder --win --x64 --publish always",
    "release:linux": "electron-builder --linux --x64 --publish always"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.semih.ogretmenai",
    "productName": "Ogretmen AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*",
      "piper/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "language": "1055"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "semihkayags9-crypto",
      "repo": "ogretmen-ai"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
